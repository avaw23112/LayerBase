<#= cons #>
    {
        return new ProjectionBringFlow0<#= suffix #><<#= allG #>>(_world, _query, _predicate);
    }

<# } #>
    public void TouchProjectedActor()
    {
        ProjectionExecutor0.Touch(_world, _query, _predicate);
    }
}

