<# } #>
    public void TouchProjectedActor()
    {
        ProjectionExecutor<#= c #><<#= compG #>>.Touch(_world, _query, _predicate);
    }

    public void ForEach<TJob>(
        ref TJob job)
        where TJob : struct, IQueryJob<<#= compG #>>
    {
        ProjectionExecutor<#= c #><<#= compG #>>.ForEach(
            _world,
            _query,
            _predicate,
