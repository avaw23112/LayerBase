        <ProjectReference Include="..\LayerBase.Task\LayerBase.Task.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
</Project>
